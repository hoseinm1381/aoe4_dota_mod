<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation">
  <Grid.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,ui/Resources/HUDResources.xaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Grid.Resources>
  <Border Width="760" Padding="30" Background="#F2151E2A" BorderBrush="#B98F50"
          BorderThickness="2" HorizontalAlignment="Center" VerticalAlignment="Center">
    <StackPanel>
      <TextBlock Text="LANE WARS  /  PROVING GROUND" FontSize="14" FontWeight="Bold"
                 Foreground="#DEB979" HorizontalAlignment="Center"/>
      <TextBlock Text="Choose your hero" FontSize="36" Margin="0,5,0,24"
                 Foreground="#F8EDDA" HorizontalAlignment="Center"/>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="18"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="#252D3A" BorderBrush="#A36D43"
                BorderThickness="1,4,1,1" Padding="19">
          <StackPanel>
            <TextBlock Text="FRONTLINE  /  MELEE" Foreground="#E3AE76" FontSize="13" FontWeight="Bold"/>
            <TextBlock Text="Shield Captain" Foreground="#F8EDDA" FontSize="25" Margin="0,5,0,14"/>
            <TextBlock Text="210 health  ·  Sword and shield" Foreground="#E7E2D5" FontSize="15"/>
            <TextBlock Text="Second Wind restores up to 25% of your health." Foreground="#C4CDDA"
                       FontSize="15" TextWrapping="Wrap" MinHeight="53" Margin="0,6,0,12"/>
            <Button Style="{StaticResource HUDBaseButtonStyle}" Height="40"
                    Content="Draft Shield Captain" Command="{Binding [pickCaptain]}"/>
          </StackPanel>
        </Border>
        <Border Grid.Column="2" Background="#232F37" BorderBrush="#638C79"
                BorderThickness="1,4,1,1" Padding="19">
          <StackPanel>
            <TextBlock Text="SKIRMISHER  /  RANGED" Foreground="#A9D0BB" FontSize="13" FontWeight="Bold"/>
            <TextBlock Text="Bow Skirmisher" Foreground="#F8EDDA" FontSize="25" Margin="0,5,0,14"/>
            <TextBlock Text="145 health  ·  Longbow" Foreground="#E7E2D5" FontSize="15"/>
            <TextBlock Text="Quickstep increases movement speed for five seconds." Foreground="#C4CDDA"
                       FontSize="15" TextWrapping="Wrap" MinHeight="53" Margin="0,6,0,12"/>
            <Button Style="{StaticResource HUDBaseButtonStyle}" Height="40"
                    Content="Draft Bow Skirmisher" Command="{Binding [pickBow]}"/>
          </StackPanel>
        </Border>
      </Grid>
      <TextBlock Text="The lane opens when you pick. Your opponent takes the other hero."
                 Foreground="#C4CDDA" FontSize="15" Margin="0,21,0,0"
                 HorizontalAlignment="Center" TextWrapping="Wrap"/>
    </StackPanel>
  </Border>
</Grid>
