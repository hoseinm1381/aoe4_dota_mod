            <TextBlock Text="Bow Skirmisher" Foreground="#F8EDDA" FontSize="25" Margin="0,5,0,14"/>
            <TextBlock Text="145 health  ·  Longbow" Foreground="#E7E2D5" FontSize="15"/>
            <TextBlock Text="Quickstep increases movement speed for five seconds." Foreground="#C4CDDA"
                       FontSize="15" TextWrapping="Wrap" MinHeight="53" Margin="0,6,0,12"/>
            <Button Style="{StaticResource HUDBaseButtonStyle}" Height="40"
                    Content="Draft Bow Skirmisher" Command="{Binding [pickBow]}"/>
          </StackPanel>
        </Border>
      </Grid>
      <TextBlock Text="The lane opens when you pick. Your opponent takes the other hero."
