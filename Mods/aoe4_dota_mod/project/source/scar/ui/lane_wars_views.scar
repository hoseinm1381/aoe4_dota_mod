<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation">
  <Grid.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,ui/Resources/HUDResources.xaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Grid.Resources>
  <Border Width="290" Padding="15" Margin="0,0,24,285" Background="#F2151E2A" BorderBrush="#B98F50"
          BorderThickness="1,3,1,1" HorizontalAlignment="Right" VerticalAlignment="Bottom">
    <StackPanel>
      <TextBlock Text="PROVING GROUND" Foreground="#DEB979" FontWeight="Bold" FontSize="12"/>
      <TextBlock Text="{Binding [hero]}" Foreground="#F8EDDA" FontSize="23" Margin="0,4,0,3"/>
      <TextBlock Text="{Binding [vitals]}" Foreground="#EBE0CF" FontSize="15"/>
      <TextBlock Text="{Binding [progress]}" Foreground="#C4CDDA" FontSize="14" Margin="0,2,0,0"/>
      <TextBlock Text="{Binding [objective]}" Foreground="#DEB979" FontSize="14" Margin="0,8,0,10"/>
      <Button Style="{StaticResource HUDBaseButtonStyle}" Height="32"
              Content="{Binding [skillLabel]}" Command="{Binding [useSkill]}" IsEnabled="{Binding [canUseSkill]}"/>
      <Button Style="{StaticResource HUDBaseButtonStyle}" Height="32" Margin="0,5,0,0"
              Content="{Binding [bootsLabel]}" Command="{Binding [buyBoots]}" IsEnabled="{Binding [canBuyBoots]}"/>
      <Button Style="{StaticResource HUDBaseButtonStyle}" Height="32" Margin="0,5,0,0"
              Content="{Binding [tonicLabel]}" Command="{Binding [useOrBuyTonic]}" IsEnabled="{Binding [canTonic]}"/>
      <TextBlock Text="{Binding [shopHint]}" Foreground="#C4CDDA" FontSize="13"
                 Margin="0,9,0,0" TextWrapping="Wrap"/>
    </StackPanel>
  </Border>
</Grid>
