import("cardinal.scar")
import("ScarUtil.scar")
import("command.scar")
import("network.scar")
import("aoe4_dota_mod/garrison.scar")
import("aoe4_dota_mod/blueprints.scar")
import("aoe4_dota_mod/options.scar")

Core_RegisterModule("LaneWarsSolo")

local blueprints
local lobby
local match
local interval = 0.25
local wavePeriod = 30
local respawnDelay = 12
local draftEvent = "LaneWarsSolo_OnAction"
local levelThresholds = {0, 100, 250, 450, 700, 1000}
local heroNames = {"Shield Captain", "Bow Skirmisher"}
local lobbyPicks = {captain = 1, bow = 2}
local audio = Garrison.mods.aoe4_dota_mod.audio

local function Ground(x, z)
	return World_Pos(x, World_GetHeightAt(x, z), z)
end

local function Site(coordinates)
	return Ground(coordinates[1], coordinates[2])
end

local function ResolveLayout()
	local map = LaneWarsProvingGround
	if map == nil then
		print("LANE_WARS_SETUP_ERROR Proving Ground map script was not loaded")
		return
	end
	local function InBounds(offsetX, offsetZ)
		for _, side in ipairs({map.west, map.east}) do
			for _, point in pairs(side) do
				if not World_PosInBounds(World_Pos(point[1] + offsetX, 0, point[2] + offsetZ)) then
					return false
				end
			end
		end
		return true
	end
	local offsetX, offsetZ = 0, 0
	if not InBounds(offsetX, offsetZ) then
		offsetX, offsetZ = World_GetWidth() / 2, World_GetLength() / 2
		if not InBounds(offsetX, offsetZ) then
			print("LANE_WARS_SETUP_ERROR authored lane lies outside the playable world", offsetX * 2, offsetZ * 2)
			return
		end
	end
	local function Offset(side)
		local result = {}
		for key, point in pairs(side) do
			result[key] = {point[1] + offsetX, point[2] + offsetZ}
		end
		return result
	end
	print("LANE_WARS_LAYOUT_READY", offsetX, offsetZ)
	return Offset(map.west), Offset(map.east)
end

local function SpawnSquad(blueprint, player, position, destination)
	local squad = Squad_CreateAndSpawnToward(blueprint, player, 1, position, destination)
	return {handle = squad, id = Squad_GetID(squad), position = position}
end

local function SpawnBuilding(blueprint, player, position, kind)
	local entity = Entity_Create(blueprint, player, position, true)
	Entity_Spawn(entity)
	Entity_ForceConstruct(entity)
	Entity_SetHealth(entity, 1)
	print(string.format("LANE_WARS_BUILDING_READY slot=%d kind=%s progress=%.2f hp=%.0f/%.0f",
		Player_GetSlotIndex(player), kind, Entity_GetBuildingProgress(entity),
		Entity_GetHealth(entity), Entity_GetHealthMax(entity)))
	return {handle = entity, id = Entity_GetID(entity)}
end

local function AliveSquad(unit)
	return unit ~= nil and Squad_IsValid(unit.id) and Squad_IsAlive(unit.handle)
end

local function AliveBuilding(building)
	return Entity_IsValid(building.id) and Entity_IsAlive(building.handle)
end

local function Order(unit, destination)
	SGroup_Clear(match.orderGroup)
	SGroup_Add(match.orderGroup, unit.handle)
	Cmd_AttackMove(match.orderGroup, destination)
	SGroup_Clear(match.orderGroup)
end

local function SpawnHero(side, opponent)
	side.hero = SpawnSquad(blueprints.heroes[side.pick], side.player, Site(side.layout.hero), Site(opponent.layout.hero))
	side.respawnAt = nil
	if side.boots then
		Modifier_ApplyToEntity(match.boots, Squad_GetFirstEntity(side.hero.handle), 0)
	end
	if side.human and match.audio and side.pick == 1 then
		local site = side.layout.hero
		audio.event("captain_ready", World_GetGameTime(), site[1], site[2])
	end
	if not side.human then
		Order(side.hero, Site(opponent.layout.stronghold))
	end
	print("LANE_WARS_HERO_SPAWN", Player_GetSlotIndex(side.player), side.pick, side.hero.id)
end

local function SpawnBases()
	for _, side in ipairs(match.sides) do
		side.tower = SpawnBuilding(blueprints.tower, side.player, Site(side.layout.tower), "tower")
		side.stronghold = SpawnBuilding(blueprints.stronghold, side.player, Site(side.layout.stronghold), "stronghold")
		Entity_SetInvulnerableMinCap(side.stronghold.handle, 1, -1)
		if side.human then
			Misc_SetEntitySelectable(side.tower.handle, false)
			Misc_SetEntitySelectable(side.stronghold.handle, false)
		end
	end
end

local function StartBattle(now)
	match.phase = "battle"
	match.nextWave = now + 4
	match.nextIncome = now + 1
	for index, side in ipairs(match.sides) do
		SpawnHero(side, match.sides[3 - index])
	end
	print("LANE_WARS_BATTLE_STARTED")
end

local function Draft(pick, now, source)
	local human = match.human
	human.pick = pick
	match.opponent.pick = 3 - pick
	print(string.format("LANE_WARS_DRAFT_PICK source=%s hero=%s", source, heroNames[pick]))
	StartBattle(now)
end

local function SpawnWave(side, opponent)
	if #side.waves >= 3 then
		return
	end
	local wave = {}
	for index, offset in ipairs({-4.5, -1.5, 1.5, 4.5}) do
		local blueprint = index == 4 and blueprints.ranged or blueprints.melee
		local position = Ground(side.layout.wave[1], side.layout.wave[2] + offset)
		local destination = Ground(opponent.layout.stronghold[1], offset)
		local unit = SpawnSquad(blueprint, side.player, position, destination)
		if side.human then
			Misc_SetSquadSelectable(unit.handle, false)
		end
		match.creeps[unit.id] = unit
		Rule_AddSquadEvent(LaneWarsSolo_OnCreepKilled, unit.handle, GE_SquadKilled, {id = unit.id})
		Order(unit, destination)
		wave[index] = unit
	end
	table.insert(side.waves, wave)
	if not side.loggedFirstWave then
		side.loggedFirstWave = true
		print("LANE_WARS_FIRST_WAVE", Player_GetSlotIndex(side.player), #wave)
	end
end

local function CaptureCreepDeath(creep)
	if creep.deathCaptured or not Squad_IsValid(creep.id) then
		return
	end
	creep.deathCaptured = true
	-- Read the last entity attacker during the death event, before the squad is
	-- discarded. A tower never inherits an earlier hero hit.
	EGroup_Clear(match.attackerGroup)
	Squad_GetLastEntityAttacker(creep.handle, match.attackerGroup)
	if EGroup_Count(match.attackerGroup) == 1 then
		local attacker = Entity_GetSquad(EGroup_GetEntityAt(match.attackerGroup, 1))
		if attacker ~= nil then
			creep.killerId = Squad_GetID(attacker)
		end
	end
end

function LaneWarsSolo_OnCreepKilled(context, data)
	if match == nil or match.phase ~= "battle" or context == nil or data == nil then
		return
	end
	local creep = match.creeps[data.id]
	if creep ~= nil and context.victim == creep.handle then
		CaptureCreepDeath(creep)
	end
end

local function RewardCreep(creep, enemy)
	if AliveSquad(enemy.hero) and World_DistancePointToPoint(Squad_GetPosition(enemy.hero.handle), creep.position) <= 22 then
		enemy.xp = enemy.xp + 15
		while levelThresholds[enemy.level + 1] and enemy.xp >= levelThresholds[enemy.level + 1] do
			enemy.level = enemy.level + 1
			print("LANE_WARS_HERO_LEVEL", Player_GetSlotIndex(enemy.player), enemy.level)
		end
	end

	CaptureCreepDeath(creep)
	if not creep.deathCaptured then
		if not match.loggedMissingDeathHandle then
			match.loggedMissingDeathHandle = true
			print("LANE_WARS_LAST_HIT_DEATH_HANDLE_UNAVAILABLE", creep.id)
		end
		return
	end
	if enemy.hero ~= nil and creep.killerId == enemy.hero.id then
		Player_SetResource(enemy.player, RT_Gold, Player_GetResource(enemy.player, RT_Gold) + 30)
		print("LANE_WARS_LAST_HIT", creep.id, enemy.hero.id)
	end
	if enemy.human and match.attributionSamples < 12 then
		match.attributionSamples = match.attributionSamples + 1
		print(string.format("LANE_WARS_CREEP_RESULT victim=%d killer=%s hero=%s",
			creep.id, tostring(creep.killerId), tostring(enemy.hero and enemy.hero.id)))
	end
end

local function UpdateWaves(side, enemy)
	for waveIndex = #side.waves, 1, -1 do
		local wave = side.waves[waveIndex]
		for unitIndex = #wave, 1, -1 do
			local creep = wave[unitIndex]
			if AliveSquad(creep) then
				creep.position = Squad_GetPosition(creep.handle)
			else
				RewardCreep(creep, enemy)
				match.creeps[creep.id] = nil
				table.remove(wave, unitIndex)
			end
		end
		if #wave == 0 then
			table.remove(side.waves, waveIndex)
		end
	end
end

local function AtShop(side)
	return AliveSquad(side.hero) and World_DistancePointToPoint(Squad_GetPosition(side.hero.handle), Site(side.layout.hero)) <= 12
end

function LaneWarsSolo_OnAction(sender, action)
	if match == nil or sender ~= match.human.player then
		return
	end
	local side = match.human
	if match.phase == "draft" then
		local pick = lobbyPicks[action]
		if pick then
			Draft(pick, World_GetGameTime(), "dialog")
		end
		return
	end
	if match.phase ~= "battle" or not AliveSquad(side.hero) then
		return
	end
	local gold = Player_GetResource(side.player, RT_Gold)
	local now = World_GetGameTime()
	if action == "skill" and now >= (side.skillReadyAt or 0) then
		if side.pick == 1 then
			local health = Squad_GetHealthPercentage(side.hero.handle, false)
			if health >= 1 then
				return
			end
			Squad_SetHealth(side.hero.handle, math.min(1, health + 0.25))
		else
			Modifier_ApplyToEntity(match.quickstep, Squad_GetFirstEntity(side.hero.handle), 5)
		end
		side.skillReadyAt = now + 24
		print("LANE_WARS_SKILL " .. heroNames[side.pick])
	elseif action == "boots" and not side.boots and gold >= 75 and AtShop(side) then
		Modifier_ApplyToEntity(match.boots, Squad_GetFirstEntity(side.hero.handle), 0)
		side.boots = true
		Player_SetResource(side.player, RT_Gold, gold - 75)
		print("LANE_WARS_SHOP", "boots")
	elseif action == "buy_tonic" and not side.tonic and gold >= 30 and AtShop(side) then
		side.tonic = true
		Player_SetResource(side.player, RT_Gold, gold - 30)
		print("LANE_WARS_SHOP", "buy_tonic")
	elseif action == "use_tonic" and side.tonic then
		local health = Squad_GetHealthPercentage(side.hero.handle, false)
		if health < 1 then
			Squad_SetHealth(side.hero.handle, math.min(1, health + 0.25))
			side.tonic = false
			print("LANE_WARS_SHOP", "use_tonic")
		end
	end
end

local function ClearCues()
	for _, id in ipairs(match.cues) do
		UI_ClearEventCueFromID(id)
	end
	match.cues = {}
end

local function Cue(title, callback)
	local id = UI_CreateEventCueClickable(-1, 3600, 0, 0, LOC(title), Loc_Empty(),
		"high_priority", "icons\\event_queue_high_priority_large", "", 255, 255, 255, 255,
		ECV_Queue | ECV_Title, callback)
	if id ~= nil then
		table.insert(match.cues, id)
	end
end

-- The engine looks up UI callbacks by their global names.
function LaneWarsSolo_OnHeroDialog(button)
	if match == nil or match.phase ~= "draft" or not match.dialogOpen then
		return
	end
	match.dialogOpen = false
	if button == DB_Button1 or button == DB_Button2 then
		match.draftRetryAt = World_GetGameTime() + 2
		Network_CallEvent(draftEvent, button == DB_Button1 and "captain" or "bow")
	end
end

local function ShowHeroDialog()
	if match.dialogOpen or World_GetGameTime() < match.draftRetryAt then
		return
	end
	match.dialogOpen = true
	UI_MessageBoxReset()
	UI_MessageBoxSetText("Choose your hero", "The lane begins once you choose. Your opponent takes the other hero.")
	UI_MessageBoxSetButton(DB_Button1, heroNames[1], "Melee fighter. Second Wind restores up to 25% health.", "", true)
	UI_MessageBoxSetButton(DB_Button2, heroNames[2], "Ranged fighter. Quickstep boosts movement speed for five seconds.", "", true)
	UI_MessageBoxShow(DC_Default, LaneWarsSolo_OnHeroDialog)
	print("LANE_WARS_DRAFT_DIALOG_SHOWN")
end

function LaneWarsSolo_UseSkill()
	Network_CallEvent(draftEvent, "skill")
end

function LaneWarsSolo_BuyBoots()
	Network_CallEvent(draftEvent, "boots")
end

function LaneWarsSolo_BuyTonic()
	Network_CallEvent(draftEvent, "buy_tonic")
end

function LaneWarsSolo_UseTonic()
	Network_CallEvent(draftEvent, "use_tonic")
end

function LaneWarsSolo_LevelCue()
end

local function UpdateHUD()
	if Game_GetLocalPlayer() ~= match.human.player then
		return
	end
	local side = match.human
	if match.phase == "draft" then
		ShowHeroDialog()
		return
	end
	local near = AtShop(side)
	local available = Player_GetResource(side.player, RT_Gold)
	local skillReady = AliveSquad(side.hero) and World_GetGameTime() >= (side.skillReadyAt or 0)
	local status = table.concat({match.phase, side.level, tostring(near), tostring(side.boots),
		tostring(side.tonic), tostring(available >= 75), tostring(available >= 30),
		tostring(AliveSquad(side.hero)), tostring(skillReady)}, "/")
	if status == match.hudStatus then
		return
	end
	match.hudStatus = status
	ClearCues()
	Cue(heroNames[side.pick] .. " | Level " .. side.level .. " of 6", LaneWarsSolo_LevelCue)
	if skillReady then
		Cue(side.pick == 1 and "Second Wind | Restore health" or "Quickstep | Move faster", LaneWarsSolo_UseSkill)
	end
	if near and not side.boots and available >= 75 then
		Cue("Buy Marching Boots for 75 gold", LaneWarsSolo_BuyBoots)
	end
	if near and not side.tonic and available >= 30 then
		Cue("Buy a tonic for 30 gold", LaneWarsSolo_BuyTonic)
	elseif side.tonic and AliveSquad(side.hero) then
		Cue("Drink tonic to recover 25% health", LaneWarsSolo_UseTonic)
	end
end

local function Finish(loser, winner)
	match.phase = "over"
	print("LANE_WARS_MATCH_FINISHED", Player_GetSlotIndex(winner.player))
	Core_SetPlayerDefeated(loser.player, nil, WR_CONQUEST)
	World_KillPlayer(loser.player, KPR_Lost)
	Core_SetPlayerVictorious(winner.player, nil, WR_CONQUEST)
	Core_OnGameOver()
end

function LaneWarsSolo_Tick()
	local now = World_GetGameTime()
	if match.audio then
		audio.pulse(now)
	end
	if match.phase == "battle" then
		for index, side in ipairs(match.sides) do
			local opponent = match.sides[3 - index]
			if not AliveBuilding(side.stronghold) then
				Finish(side, opponent)
				return
			end
			if not side.exposed and not AliveBuilding(side.tower) then
				side.exposed = true
				Entity_SetInvulnerableMinCap(side.stronghold.handle, 0, -1)
				if match.audio and not side.human then
					local tower = Site(side.layout.tower)
					audio.event("tower_impact", now, tower.x, tower.z)
				end
				print("LANE_WARS_STRONGHOLD_EXPOSED", Player_GetSlotIndex(side.player))
			end
			UpdateWaves(side, opponent)
			if not AliveSquad(side.hero) then
				side.respawnAt = side.respawnAt or now + respawnDelay
				if now >= side.respawnAt then
					SpawnHero(side, opponent)
				end
			end
			if now >= match.nextIncome then
				Player_SetResource(side.player, RT_Gold, Player_GetResource(side.player, RT_Gold) + 2)
			end
			if now >= match.nextWave then
				SpawnWave(side, opponent)
			end
		end
		if now >= match.nextIncome then
			match.nextIncome = now + 1
		end
		if now >= match.nextWave then
			match.nextWave = now + wavePeriod
		end
	end
	UpdateHUD()
end

local function FindBlueprint(resolve, name)
	local found, blueprint = pcall(resolve, name)
	if found and blueprint then
		return blueprint
	end
	print("LANE_WARS_SETUP_ERROR missing blueprint", name)
end

function LaneWarsSolo_OnGameSetup()
	blueprints = nil
	lobby = Garrison.mods.aoe4_dota_mod.options.load().solo or {}
	local private = Garrison.mods.aoe4_dota_mod.blueprints
	local required = {
		heroes = {
			FindBlueprint(BP_GetSquadBlueprint, private.sbps.shield_captain),
			FindBlueprint(BP_GetSquadBlueprint, private.sbps.bow_skirmisher),
		},
		melee = FindBlueprint(BP_GetSquadBlueprint, "unit_spearman_2_eng"),
		ranged = FindBlueprint(BP_GetSquadBlueprint, "unit_archer_2_eng"),
		tower = FindBlueprint(BP_GetEntityBlueprint, private.ebps.lane_tower),
		stronghold = FindBlueprint(BP_GetEntityBlueprint, private.ebps.lane_stronghold),
	}
	if not (required.heroes[1] and required.heroes[2] and required.melee
		and required.ranged and required.tower and required.stronghold) then
		return
	end
	blueprints = required
	for index = 1, World_GetPlayerCount() do
		local player = World_GetPlayerAt(index)
		for _, blueprint in ipairs({blueprints.heroes[1], blueprints.heroes[2], blueprints.melee, blueprints.ranged}) do
			Squad_Precache(blueprint, 0, player, "", "DynamicPrecaching", "")
		end
		Entity_Precache(blueprints.tower, 0, player, "", "DynamicPrecaching", "")
		Entity_Precache(blueprints.stronghold, 0, player, "", "DynamicPrecaching", "")
	end
end

function LaneWarsSolo_OnInit()
	Network_RegisterEvent(draftEvent)
end

function LaneWarsSolo_Start()
	if match ~= nil or blueprints == nil then
		return
	end
	local west, east = ResolveLayout()
	if west == nil then
		return
	end
	local human, opponent
	for _, player in pairs(PLAYERS) do
		if Player_IsAlive(player.id) then
			local isHuman = Player_IsHuman(player.id)
			local side = {player = player.id, human = isHuman, xp = 0, level = 1, waves = {},
				layout = isHuman and west or east}
			if isHuman and human == nil then
				human = side
			elseif not isHuman and opponent == nil then
				opponent = side
			else
				print("LANE_WARS_SETUP_ERROR expected exactly one human and one AI")
				return
			end
		end
	end
	if human == nil or opponent == nil
		or Player_ObserveRelationship(human.player, opponent.player) ~= R_ENEMY then
		print("LANE_WARS_SETUP_ERROR place one human and one AI on opposing teams")
		return
	end
	AI_Enable(opponent.player, false)
	local startingEntities = EGroup_Create("lane_wars_stock_start")
	for _, side in ipairs({human, opponent}) do
		SGroup_DestroyAllSquads(Player_GetSquads(side.player))
		EGroup_Clear(startingEntities)
		Player_GetEntitiesEGroup(side.player, startingEntities)
		EGroup_DestroyAllEntities(startingEntities)
		Player_SetResource(side.player, RT_Food, 0)
		Player_SetResource(side.player, RT_Wood, 0)
		Player_SetResource(side.player, RT_Stone, 0)
		Player_SetResource(side.player, RT_Gold, 0)
	end
	EGroup_Destroy(startingEntities)

	match = {
		human = human, opponent = opponent, sides = {human, opponent},
		phase = "draft", draftRetryAt = 0, cues = {}, creeps = {}, attributionSamples = 0,
		audio = lobby.media == true and audio ~= nil,
		orderGroup = SGroup_Create("lane_wars_order"),
		attackerGroup = EGroup_Create("lane_wars_last_attacker"),
		boots = Modifier_Create(MAT_Entity, "speed_maximum_modifier", MUT_Multiplication, false, 1.12, nil),
		quickstep = Modifier_Create(MAT_Entity, "speed_maximum_modifier", MUT_Multiplication, false, 1.35, nil),
	}
	SpawnBases()
	if Game_GetLocalPlayer() == human.player then
		Camera_FocusOnPosition(Site(human.layout.hero))
	end
	print("LANE_WARS_DRAFT_STARTED")
	Rule_AddInterval(LaneWarsSolo_Tick, interval)
	if match.audio then
		audio.session()
		audio.bed("audio/crossing-watch-loop.wav", 0.32)
	end
	local chosen = lobbyPicks[lobby.hero]
	if chosen then
		Draft(chosen, World_GetGameTime(), "lobby")
	end
	UpdateHUD()
end

function LaneWarsSolo_OnGameOver()
	if match ~= nil then
		match.phase = "over"
		if match.dialogOpen then
			match.dialogOpen = false
			UI_MessageBoxHide(DB_Close)
		end
		if match.audio then
			audio.stop()
		end
		Rule_Remove(LaneWarsSolo_Tick)
		ClearCues()
		-- Killed squads lose their attached event rules. Retire surviving rules
		-- explicitly before destroying the group used for attribution.
		for _, side in ipairs(match.sides) do
			for _, wave in ipairs(side.waves) do
				for _, creep in ipairs(wave) do
					if AliveSquad(creep) then
						Rule_RemoveSquadEvent(LaneWarsSolo_OnCreepKilled, creep.handle)
					end
				end
			end
		end
		SGroup_Destroy(match.orderGroup)
		EGroup_Destroy(match.attackerGroup)
		match = nil
	end
end
